/**
 * Writes the panel's venue changes into content/mekanlar/yayin.ts (D-19, K-50): each registered
 * venue's mode and its active domains. Runs in scripts/vercel-build.mjs after the seed and before
 * `next build`, so the host map and the static pages carry them (ADR-0002). Hosts are checked
 * against the registry's hostname rule; a bad row is skipped, never written.
 * Run with: pnpm venues:export   (tsx --conditions=react-server)
 */
import { writeFileSync } from "node:fs";

import nextEnv from "@next/env";

nextEnv.loadEnvConfig(process.cwd());

const { venueRecords } = await import("../content/mekanlar");
const { withPlatform } = await import("@/server/db/tenant");
const { venueDomains } = await import("@/server/db/tenant/tables");
const { venues } = await import("@/server/db/schema");
const { eq } = await import("drizzle-orm");

const HOST = /^(?=.{1,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$/;
const known = new Set(venueRecords.map((record) => record.slug));

const rows = await withPlatform(async (tx) => {
  const facts = await tx
    .select({ id: venues.id, slug: venues.slug, mode: venues.mode })
    .from(venues);
  const hosts = await tx
    .select({ venueId: venueDomains.venueId, host: venueDomains.host })
    .from(venueDomains)
    .where(eq(venueDomains.status, "active"))
    .orderBy(venueDomains.createdAt);
  return { facts, hosts };
});

const overlay: Record<string, { mode: "demo" | "live"; domains: string[] }> = {};
for (const venue of rows.facts) {
  if (!known.has(venue.slug)) continue;
  overlay[venue.slug] = {
    mode: venue.mode === "live" ? "live" : "demo",
    domains: rows.hosts
      .filter((row) => row.venueId === venue.id && HOST.test(row.host))
      .map((row) => row.host),
  };
}

const source = `import type { RegistryOverlay } from "../../src/platform/tenant/registry-schema";

// Generated by pnpm venues:export during the Vercel build (K-50). Do not edit by hand.
export const registryOverlay: RegistryOverlay = ${JSON.stringify(overlay, null, 2)};
`;
writeFileSync(new URL("../content/mekanlar/yayin.ts", import.meta.url), source);
console.log(`✓ Yayın katmanı: ${Object.keys(overlay).length} mekân`);
process.exit(0);
