# Copy to .env.local and fill in. Never commit real values (11-guvenlik §10).
# Every variable is validated at start-up by src/lib/env.ts and src/lib/public-env.ts.

# ── Database ─────────────────────────────────────────────────────────
# Local: docker compose up -d (host port 5436, plan K-30). Neon: pooled URL here, direct URL below.
DATABASE_URL=postgres://app:app@localhost:5436/app
# Direct (unpooled) connection, used by migrations. Optional locally.
DATABASE_URL_UNPOOLED=

# ── Platform ─────────────────────────────────────────────────────────
# The platform's own address (introduction page + panel), no trailing slash. Local port 3020 (K-30).
# Venue sites use their own domains (venue_domains, ADR-0002), never this value.
NEXT_PUBLIC_PLATFORM_URL=http://localhost:3020
# true: platform pages noindex + demo banner, panel e-mails go to the demo outbox, db:reset allowed,
# demo panel login shown. Each venue has its own mode (venues.mode: demo | live, plan K-06).
# false (live platform): RESEND_API_KEY and EMAIL_FROM become mandatory; DEMO_ADMIN_* must be empty.
PLATFORM_DEMO=true

# ── Auth (Better Auth) ───────────────────────────────────────────────
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3020
# Seeded demo platform admin (demo environments only). Password: at least 15 characters.
DEMO_ADMIN_EMAIL=yonetici@kartela.example.com
DEMO_ADMIN_PASSWORD=

# ── Security ─────────────────────────────────────────────────────────
# Salt for hashing IPs in audit records and the stats rate limit. openssl rand -hex 16
IP_HASH_SALT=
# Bearer token Vercel Cron sends to /api/cron/*. openssl rand -hex 24
CRON_SECRET=

# ── Channels ─────────────────────────────────────────────────────────
# E-mail (Resend): panel invitations and password resets. Empty in demo: demo outbox.
RESEND_API_KEY=
# "Kartela <bildirim@alanadi.com.tr>" — domain verified with SPF, DKIM, DMARC
EMAIL_FROM=

# ── Storage and monitoring ───────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=
SENTRY_DSN=
